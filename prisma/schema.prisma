datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Category {
  GENERAL_AVIATION
  COMMERCIAL_AIRLINER
  MILITARY
  SUPERSONIC
  EXPERIMENTAL
}

enum Era {
  PIONEER
  WWII
  JET_AGE
  MODERN
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  username      String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  favorites     Favorite[]
  ratings       Rating[]
  personalNotes PersonalNote[]
  flightLogs    FlightLog[]
}

model Aircraft {
  id                         String          @id @default(uuid())
  slug                       String          @unique
  name                       String
  isConcept                  Boolean         @default(false)
  category                   Category
  era                        Era
  releaseYear                Int?
  topSpeedKmh                Float
  serviceCeilingFt           Float
  maxRangeNm                 Float
  wingspanM                  Float
  maxTakeoffWeightLbs        Float
  stallSpeedKts              Float
  liftToDragRatio            Float
  engineType                 String
  description                String          @db.Text
  flightControlsDescription String          @db.Text
  youtubeId                  String
  schematicUrl               String?
  images                     AircraftImage[]
  tags                       Tag[]
  favorites                  Favorite[]
  ratings                    Rating[]
  personalNotes              PersonalNote[]

  @@index([category])
  @@index([era])
  @@index([slug])
}

model AircraftImage {
  id         String   @id @default(uuid())
  aircraftId String
  url        String
  caption    String?
  source     String
  license    String
  aircraft   Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@unique([aircraftId, url])
  @@index([aircraftId])
}

model Tag {
  id        String     @id @default(uuid())
  name      String     @unique
  aircrafts Aircraft[]
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  aircraftId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aircraft   Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@unique([userId, aircraftId])
  @@index([userId])
  @@index([aircraftId])
}

model Rating {
  id         String   @id @default(uuid())
  userId     String
  aircraftId String
  stars      Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aircraft   Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@unique([userId, aircraftId])
  @@index([userId])
  @@index([aircraftId])
}

model PersonalNote {
  id         String   @id @default(uuid())
  userId     String
  aircraftId String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aircraft   Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([aircraftId])
}

model FlightLog {
  id           String   @id @default(uuid())
  userId       String
  title        String
  flightHours  Float
  aircraftType String
  notes        String   @db.Text
  date         DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
