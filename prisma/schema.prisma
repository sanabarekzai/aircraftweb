datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Category {
  GENERAL_AVIATION
  COMMERCIAL_AIRLINER
  MILITARY
  SUPERSONIC
  EXPERIMENTAL
}

enum Era {
  PIONEER
  WWII
  JET_AGE
  MODERN
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  username      String         @unique
  passwordHash  String
  isAdmin       Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  favorites     Favorite[]
  ratings       Rating[]
  personalNotes PersonalNote[]
  flightLogs    FlightLog[]
  bookings      Booking[]
  reviews       Review[]
  reviewReports ReviewReport[]
}

model Aircraft {
  id                         String          @id @default(uuid())
  slug                       String          @unique
  name                       String
  isConcept                  Boolean         @default(false)
  category                   Category
  era                        Era
  releaseYear                Int?
  topSpeedKmh                Float
  serviceCeilingFt           Float
  maxRangeNm                 Float
  wingspanM                  Float
  maxTakeoffWeightLbs        Float
  stallSpeedKts              Float
  liftToDragRatio            Float
  engineType                 String
  description                String          @db.Text
  flightControlsDescription String          @db.Text
  youtubeId                  String
  schematicUrl               String?
  images                     AircraftImage[]
  tags                       Tag[]
  favorites                  Favorite[]
  ratings                    Rating[]
  personalNotes              PersonalNote[]
  flightLogs                 FlightLog[]
  bookings                   Booking[]
  reviews                    Review[]

  @@index([category])
  @@index([era])
  @@index([slug])
}

model AircraftImage {
  id         String   @id @default(uuid())
  aircraftId String
  url        String
  caption    String?
  source     String
  license    String
  aircraft   Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@unique([aircraftId, url])
  @@index([aircraftId])
}

model Tag {
  id        String     @id @default(uuid())
  name      String     @unique
  aircrafts Aircraft[]
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  aircraftId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aircraft   Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@unique([userId, aircraftId])
  @@index([userId])
  @@index([aircraftId])
}

model Rating {
  id         String   @id @default(uuid())
  userId     String
  aircraftId String
  stars      Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aircraft   Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@unique([userId, aircraftId])
  @@index([userId])
  @@index([aircraftId])
}

model PersonalNote {
  id         String   @id @default(uuid())
  userId     String
  aircraftId String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aircraft   Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([aircraftId])
}

model FlightLog {
  id           String   @id @default(uuid())
  userId       String
  aircraftId   String
  date         String   // ISO 8601 date string (YYYY-MM-DD)
  durationHours Float
  notes        String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aircraft     Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([aircraftId])
}

model Booking {
  id           String   @id @default(uuid())
  userId       String
  aircraftId   String
  startDate    String   // ISO 8601 date string (YYYY-MM-DD)
  endDate      String   // ISO 8601 date string (YYYY-MM-DD)
  status       String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  totalPrice   Float?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aircraft     Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([aircraftId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
}

model Review {
  id           String   @id @default(uuid())
  userId       String
  aircraftId   String
  content      String   @db.Text
  status       String   @default("PUBLISHED") // PUBLISHED, HIDDEN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aircraft     Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  reports      ReviewReport[]

  @@unique([userId, aircraftId])
  @@index([userId])
  @@index([aircraftId])
  @@index([status])
}

model ReviewReport {
  id       String   @id @default(uuid())
  reviewId String
  userId   String
  reason   String
  createdAt DateTime @default(now())
  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
}
